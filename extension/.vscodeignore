# Sources and toolchains that the packaged extension does not run.
# popcorn/dist stays, because it is what the panel loads.
popcorn/lib/**
popcorn/config/**
popcorn/deps/**
popcorn/_build/**
popcorn/assets/**
# `popcorn.cook` writes the bundle here, and the esbuild plugin copies
# it next to index.js. The panel loads the copy, thus shipping this
# folder would add the same 6.67 MB a second time.
popcorn/dist/wasm/**
popcorn/mix.exs
popcorn/mix.lock
popcorn/mise.toml
popcorn/.formatter.exs
popcorn/.gitignore
scripts/**
test/**
node_modules/**
.gitignore
.vscodeignore
**/*.map
