#
# Builds weftspun_studio from apps/weftspun_studio/Dockerfile. RFD
# 0076 moved it there, its own subdirectory under apps/, back out of
# the repo root RFD 0060 put it at — every deployed app (this one,
# apps/character_taxonomy/, apps/usd_viewer_app/) now has the same
# shape. RFD 0058.

[Build]
ImageTag=localhost/weftspun:latest
File=/opt/weftspun/src/apps/weftspun_studio/Dockerfile
SetWorkingDirectory=file
# See weftspun-crdb.build: rootful Podman's bridge network cannot
# reach the internet on this host. Network=host is build-time only —
# weftspun.container still runs on the isolated weftspun.network.
Network=host
DNS=1.1.1.1
