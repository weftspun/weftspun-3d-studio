#
# weftspun_studio, on Fly.io, with its own colocated CockroachDB —
# RFD 0062's toplevel, deployed for the first time. The plain
# `Dockerfile` stays the Podman Quadlet path (RFD 0058), a separate
# deploy target with its own CockroachDB Quadlet beside it. This
# file colocates CockroachDB in the same image instead, the shape
# `character_taxonomy/Dockerfile` already proves on Fly.io, since a
# Fly toplevel gets one Volume and one machine, not two Quadlets.
#
# Two processes run in one image: `cockroach start-single-node` and
# the weftspun_studio release. See deploy/docker-entrypoint-fly.sh.
# `versitygw` ran here too, RFD 0073's original S3 target; RFD 0073
# (weftspun/request-for-discussion) and RFD 0077 both name Tigris,
# Fly's own managed object storage, as its replacement instead — no
# self-hosted gateway to colocate, per the user's own direction.

ARG BASE_TAG=1.20.3-erlang-29.0.5-debian-bookworm-20260803-slim
ARG COCKROACH_TAG=v22.1.64b21683521d9a8735ad

FROM docker.io/hexpm/elixir:${BASE_TAG} AS build

ENV MIX_ENV=prod
# RFD 0064: this deployment runs with no GPU acceleration. Skip
# EXLA's CUDA compile entirely, since this machine has none.
ENV EXLA_CPU_ONLY=1
WORKDIR /build

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    build-essential git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN mix local.hex --force && mix local.rebar --force

COPY mix.exs mix.lock ./
RUN mix deps.get --only prod

# Deps compile from mix.exs, mix.lock, and config alone. Splitting
# this from the app's own compile means a change under priv/,
# the common case right now with the RFD 0073 gallery, does not
# bust this layer's cache and force EXLA's own CUDA-stub compile
# to run again for no reason.
COPY config config
RUN mix deps.compile

COPY lib lib
COPY priv priv
RUN mix compile
RUN mix release weftspun_container --path /build/_release

FROM docker.io/library/debian:bookworm-slim AS runtime

ARG COCKROACH_TAG
ARG TARGETARCH=amd64

RUN apt-get update -y && apt-get install -y --no-install-recommends \
    libstdc++6 openssl libncurses6 locales ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i '/en_US.UTF-8/s/^# //g' /etc/locale.gen && locale-gen

# Same V-Sekai CockroachDB build weftspun_studio's own
# deploy/Dockerfile.crdb pins. RFD 0020 selects it.
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) asset="cockroach-${COCKROACH_TAG}.linux-amd64.tgz" ;; \
      *) echo "unsupported arch: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 -o /tmp/crdb.tgz \
      "https://github.com/V-Sekai/cockroach/releases/download/${COCKROACH_TAG}/${asset}"; \
    mkdir -p /tmp/crdb; \
    tar -xzf /tmp/crdb.tgz -C /tmp/crdb; \
    bin="$(find /tmp/crdb -maxdepth 2 -type f -name cockroach | head -n1)"; \
    install -m 0755 "$bin" /usr/local/bin/cockroach; \
    rm -rf /tmp/crdb /tmp/crdb.tgz

ENV LANG=en_US.UTF-8 LANGUAGE=en_US:en LC_ALL=en_US.UTF-8
ENV WEFTSPUN_SERVE=1
ENV WEFTSPUN_PORT=4000
# RFD 0076: usd_viewer_app deploys as its own Fly app,
# weftspun-usd-viewer. Fly's private 6PN network resolves
# "<app>.internal" between apps in the same org.
ENV GALLERY_URL=http://weftspun-usd-viewer.internal:8090
# RFD 0079: AppSignal, wired through Appsignal.Plug in router.ex.
# APPSIGNAL_PUSH_API_KEY is a Fly secret, not baked in here; every
# other setting appsignal itself reads straight from these env vars,
# per its own README, no config.exs entry needed.
ENV APPSIGNAL_ACTIVE=true
ENV APPSIGNAL_APP_NAME=weftspun-studio
ENV APPSIGNAL_APP_ENV=production
ENV APPSIGNAL_OTP_APP=weftspun_studio
ENV WEFTSPUN_DB_HOST=127.0.0.1
ENV WEFTSPUN_DB_PORT=26257

WORKDIR /app
COPY --from=build /build/_release ./
COPY deploy/docker-entrypoint-fly.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh \
    && mkdir -p /data/cockroach

EXPOSE 4000
ENTRYPOINT ["/app/entrypoint.sh"]
