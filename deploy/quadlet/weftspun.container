#
# weftspun_studio itself. The entrypoint (deploy/docker-entrypoint.sh)
# migrates then execs the server, so no separate oneshot unit exists
# for that step — RFD 0058 explains why that logic moved into the
# container instead.
#
# Requires=/After= on weftspun-crdb.service and
# weftspun-usd-viewer.service is explicit because both dependencies
# cross containers; Quadlet only auto-wires the
# Network=/Volume=/Image= references below.

[Unit]
Description=weftspun_studio API server
Requires=weftspun-crdb.service
After=weftspun-crdb.service
Requires=weftspun-usd-viewer.service
After=weftspun-usd-viewer.service

[Container]
Image=weftspun.build
ContainerName=weftspun
Network=weftspun.network
# 4000 is taken on this host by the taskweft MCP server (a separate,
# long-running Burrito release, unrelated to this project). The
# container's own internal port stays 4000; only the host-side
# publish moves.
PublishPort=127.0.0.1:4001:4000
Environment=WEFTSPUN_DB_HOST=weftspun-crdb
Environment=WEFTSPUN_DB_PORT=26257
Environment=WEFTSPUN_DB_USER=root
Environment=WEFTSPUN_DB_PASSWORD=
Environment=WEFTSPUN_DB_NAME=weftspun_studio
Environment=WEFTSPUN_DB_POOL=10
Environment=WEFTSPUN_PORT=4000
Environment=WEFTSPUN_SERVE=1
Environment=GALLERY_URL=http://weftspun-usd-viewer:8090

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
