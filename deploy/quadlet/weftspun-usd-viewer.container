#
# usd_viewer_app, its own deployed container, apart from
# weftspun_studio's. RFD 0076. weftspun.container's GallerySource
# adapter reaches this one by ContainerName over weftspun.network,
# the same way it already reaches weftspun-crdb.

[Unit]
Description=usd_viewer_app (RFD 0073 gallery)

[Container]
Image=weftspun-usd-viewer.build
ContainerName=weftspun-usd-viewer
Network=weftspun.network
PublishPort=127.0.0.1:8090:8090

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target default.target
