#
# Builds the vendored-CockroachDB image from deploy/Dockerfile.crdb,
# at the repo root since RFD 0060's swap.
# scripts/deploy-weftspun-quadlet.sh syncs the repo to
# /opt/weftspun/src; that path is fixed by convention for a
# single-box deployment (RFD 0058).

[Build]
ImageTag=localhost/weftspun-crdb:latest
File=/opt/weftspun/src/deploy/Dockerfile.crdb
SetWorkingDirectory=file
# Rootful Podman's netavark bridge cannot reach the internet at all
# on this host — not just a DNS gap, `getent` itself times out on
# the bridge and answers instantly on the host network. Network=host
# here affects only this transient build container; the resulting
# image still runs on the isolated weftspun.network at runtime
# (weftspun-crdb.container), so RFD 0058's zero-trust boundary is
# unaffected. DNS=1.1.1.1 is redundant once on the host network, but
# stays as documentation of the underlying resolver gap.
Network=host
DNS=1.1.1.1
