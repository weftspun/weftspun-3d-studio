#
# Builds usd_viewer_app from its own Dockerfile, at
# /opt/weftspun/src/apps/usd_viewer_app, its own deploy unit apart
# from weftspun_studio's. RFD 0076 gives the app; the same RFD's
# later apps/ move gives this path.

[Build]
ImageTag=localhost/weftspun-usd-viewer:latest
File=/opt/weftspun/src/apps/usd_viewer_app/Dockerfile
SetWorkingDirectory=file
# See weftspun-crdb.build: rootful Podman's bridge network cannot
# reach the internet on this host, needed here for `npm ci`.
Network=host
DNS=1.1.1.1
